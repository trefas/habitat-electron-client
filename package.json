{
  "name": "habitat-client",
  "version": "1.0.0",
  "type":"module",
  "description": "Desktop client for Habitat backend",
  "author": "Andrey TrefAS Semenow",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --dir",
    "electron:dist": "vite build && electron-builder",
    "electron:dist:win": "vite build && electron-builder --win",
    "electron:dist:mac": "vite build && electron-builder --mac",
    "electron:dist:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.habitat.client",
    "productName": "Habitat Client",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "asarUnpack": [
      "**/node_modules/keytar/build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "keytar": "^7.9.0"
  }
}
