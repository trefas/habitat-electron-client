{
  "name": "habitat-client",
  "version": "1.0.1",
  "type": "module",
  "description": "Desktop client for Habitat backend",
  "author": {
    "name": "Andrey TrefAS Semenow",
    "email": "trefas@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/trefas/habitat-electron-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trefas/habitat-electron-client.git"
  },
  "bugs": {
    "url": "https://github.com/trefas/habitat-electron-client/issues"
  },
  "desktopName": "habitat-client.desktop",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --dir",
    "electron:dist": "vite build && electron-builder",
    "electron:dist:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.habitat.client",
    "productName": "Habitat Client",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "asarUnpack": [
      "**/node_modules/keytar/build/**/*"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "habitat-client",
      "syncDesktopName": true,
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "trefas",
      "repo": "habitat-electron-client",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "keytar": "^7.9.0"
  }
}
